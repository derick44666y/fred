RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=Your Name <you@yourdomain.com>
REPLY_TO=you@yourdomain.com
DAILY_LIMIT=50
PORT=3000
UNSUBSCRIBE_BASE_URL=http://localhost:3000
# Required by US CAN-SPAM law for commercial email (real street address)
MAILING_ADDRESS=Your Name, 123 Main St, City, ST 12345

# Discovery module (/api/discover) — use a licensed search API (do NOT scrape Google).
# Prefer SerpAPI if set; otherwise Google Custom Search JSON API.
SERPAPI_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Human delay jitter + cool down (ms). Default: a random 30–180s between emails.
SEND_DELAY_MIN_MS=30000
SEND_DELAY_MAX_MS=180000
# How many consecutive "invalid email" responses before sending pauses itself.
INVALID_STREAK_LIMIT=3
# How long that automatic pause lasts (minutes).
COOLDOWN_MINUTES=60

# Email verification service (optional). Discovered addresses are verified
# before they are written to the database.
#   none (default) | mock | neverbounce | zerobounce
VERIFY_PROVIDER=none
NEVERBOUNCE_API_KEY=
ZEROBOUNCE_API_KEY=
# Keep addresses the provider calls invalid out of the database (default true).
VERIFY_REJECT_INVALID=true

# Database file (SQLite). Default: data.sqlite next to the code.
# DB_PATH=./data.sqlite
